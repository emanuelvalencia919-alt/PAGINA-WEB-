@app.route("/calcular", methods=["POST"])
def calcular():
    d = request.get_json(silent=True) or {}
    try:
        especie, edad, act = d["especie"], d["edad"], d["actividad"]
        peso = float(d["peso"])
        if especie not in FACTOR_EDAD or edad not in FACTOR_EDAD[especie] \
                or act not in FACTOR_ACTIVIDAD or not (0.5 <= peso <= 90):
            raise ValueError
    except (KeyError, ValueError, TypeError):
        return jsonify(error="Datos no válidos. El peso debe estar entre 0.5 y 90 kg."), 400
    return jsonify(calcular_porcion(especie, peso, edad, act))


