# ---------------- CALCULADORA ----------------
FACTOR_EDAD = {
    "perro": {"cachorro": 2.0, "adulto": 1.6, "senior": 1.2},
    "gato":  {"cachorro": 2.5, "adulto": 1.2, "senior": 1.1},
}
FACTOR_ACTIVIDAD = {"baja": 0.85, "normal": 1.0, "alta": 1.2}
KCAL_POR_GRAMO = 3.6  # croquetas, promedio


def calcular_porcion(especie, peso, edad, actividad):
    """Energía en reposo = 70 * peso^0.75, multiplicada por un factor."""
    kcal = 70 * peso ** 0.75 * FACTOR_EDAD[especie][edad] * FACTOR_ACTIVIDAD[actividad]
    gramos = round(kcal / KCAL_POR_GRAMO)
    if edad == "cachorro":
        comidas = 4
    else:
        comidas = 3 if especie == "gato" else 2
    return {"kcal": round(kcal), "gramos": gramos, "comidas": comidas,
            "por_comida": round(gramos / comidas)}


